# Lab assistant (AI). Merge selected entries into the EXISTING project .env. Do not replace it.
# Restart the lab-manager service after any change (settings are read once at startup).
# The API key stays on the server: it is never sent to the browser, returned by the API or written to logs.

# Show the assistant panel and answer questions. false hides it everywhere (the API answers 503).
ASSISTANT_ENABLED=true

# Use the language model when a key is configured. false (or no key, or the anthropic package missing)
# keeps the assistant in "demo mode": answers are built from real lab data by fixed rules and are clearly
# labelled "מצב הדגמה — ללא מודל שפה" in every answer and in the panel header.
ASSISTANT_LLM_ENABLED=true

# Anthropic API key for the language model. Leave empty for demo mode. Never commit a real key.
# The backend reaches the API through the service's existing HTTPS_PROXY/NO_PROXY environment, if any.
# Data sent in LLM mode: the question and the lab data used to answer it (device names, management IPs, labels,
# owner names, maintenance reasons, usernames of people who performed maintenance actions, free-text notes on
# equipment, serial numbers, alert subjects, documentation snippets). Never passwords, keys or e-mail addresses,
# and never the identity of the user who asked. /api/assistant/status shows this note in Hebrew.
ASSISTANT_ANTHROPIC_API_KEY=

# A site with no user accounts (ACCOUNTS_ENABLED=false) and no LAB_MANAGER_PASSWORD is open to anyone on the
# network, so the assistant stays in demo mode there. Set true only if that exposure is acceptable.
ASSISTANT_ALLOW_OPEN_LLM=false

# Model id used for answers.
ASSISTANT_MODEL=claude-opus-5-5

# Wall-clock budget for one question, in seconds (5-600). The request fails with 504 after this
# (plus a short grace period) and nothing is stored.
ASSISTANT_TIMEOUT_SECONDS=90

# Questions allowed per user (per client address in shared-password mode) per minute and per hour.
# Over the limit the API answers 429 with a Retry-After header. Counters are kept in the database.
ASSISTANT_PER_MINUTE=6
ASSISTANT_PER_HOUR=60

# Language-model questions per day for all users together (1-100000). Beyond it, answers are given in demo
# mode with the reason shown, until the 24-hour window that started with the first counted question ends.
ASSISTANT_DAILY_LIMIT=300

# Longest question accepted, in characters.
ASSISTANT_MAX_CHARS=2000

# Questions answered at the same time across all users (each user may have at most 2 in flight).
# Extra questions are refused at once with 429 and Retry-After; they are never queued.
ASSISTANT_CONCURRENCY=4

# ---------------------------------------------------------------------------------------------------------------
# Assistant actions (2.40.0). OFF by default. Read docs/assistant-actions.md before turning them on.
# The assistant only PROPOSES power and console actions. Nothing runs until the signed-in user reviews the impact
# in the card and confirms with their own password; rack-wide and lab-wide actions also need Admin and a typed
# phrase. Actions need user accounts (ACCOUNTS_ENABLED=true): with the shared site password they are refused.
# Run exactly one backend process (never --workers): the PDU locks and the one-job-at-a-time rule are per process.
# ---------------------------------------------------------------------------------------------------------------

# Offer actions in the assistant and accept them on the server. false: no action tool, and every
# /api/assistant/actions route except /config answers 403.
ASSISTANT_ACTIONS_ENABLED=false

# Outlets that PDU, rack and lab shutdowns always keep ON, and that server/outlet actions refuse to switch:
# every power feed of the Lab Manager VM host, uplink/core/management switches, the lab firewall or router,
# the KVM appliances and the switch of the PDU/KVM management ports. Confirm them physically: labels can be wrong.
# Format: <PDU id or exact PDU name>:<outlet number>, comma-separated, e.g. <pdu-id>:4,<pdu-id>:5,<other-pdu-id>:12
# Prefer PDU ids (GET /api/devices shows them). Quote the whole value if a PDU name contains a space or '#'.
#   none  = nothing in the lab needs protection (an explicit statement; write it only after checking).
#   empty = not configured: the assistant refuses PDU, rack and lab shutdowns.
# One entry that is empty (',,' or a trailing comma), malformed, names no PDU, names a PDU name shared by two PDUs,
# or names an outlet beyond the PDU's outlet count makes the WHOLE list invalid: those shutdowns, and "Turn off all outlets" in the Maintenance
# column, are then refused until it is fixed. With a valid list the Maintenance column also keeps these outlets on.
POWER_PROTECTED_OUTLETS=

# How long a proposal can be confirmed, in seconds (30-3600). After that it expires and must be asked for again.
ASSISTANT_ACTION_TTL_SECONDS=300

# Reset of a server or outlet: seconds every feed stays off before it is switched back on (1-60).
ASSISTANT_ACTION_CYCLE_OFF_SECONDS=5

# Restore after a rack or lab shutdown: seconds to wait between PDUs, to limit inrush current (0-60).
ASSISTANT_ACTION_RESTORE_STAGGER_SECONDS=3

# A value outside its range stops the backend from starting: check `scripts/lab-service.py status` after a restart.
