# Merge selected entries into the EXISTING project .env. Do not replace it.
# Disabled until mail relay and sender are supplied.
# Network and PDU/KVM API alerts do not require electrical thresholds.
EMAIL_ALERTS_ENABLED=false
EMAIL_ALERTS_TO=aizyaguev@nvidia.com
EMAIL_ALERTS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional extra 1-minute ICMP checks, 24/7, independent of 5/30-minute history.
# Set true for prompt detection of server outages lasting more than five minutes.
# PDU/KVM API checks retain their 5/30-minute schedule.
EMAIL_ALERTS_MINUTE_PROBES=false

# Uncomment only confirmed thresholds. Values below are EXAMPLES, not defaults.
# Each rule applies to every enabled PDU inlet, not to individual server outlets.
# EMAIL_VOLTAGE_MIN=210
# EMAIL_VOLTAGE_MAX=250
# EMAIL_CURRENT_MAX=12
# EMAIL_WATTS_MAX=2500
# Lower current/power limits are also available as EMAIL_CURRENT_MIN / EMAIL_WATTS_MIN.
