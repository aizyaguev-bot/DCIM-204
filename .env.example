# Lab Manager — environment variables template
# Copy to .env and fill in real values. Never commit .env.

PDU_USERNAME=
PDU_PASSWORD=

KVM_USERNAME=
KVM_PASSWORD=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAB_MANAGER_MASTER_KEY=

# Optional: set a shared team password to gate the whole UI (Basic Auth)
LAB_MANAGER_PASSWORD=

# ── Authentication ─────────────────────────────────────────────────────────────
# Leave JWT_SECRET empty to run without JWT auth (network-trusted mode)
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Leave empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── SMTP / Email OTP ──────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to print OTPs to server log (dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
