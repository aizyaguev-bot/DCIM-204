# Merge these settings into the existing .env; do not replace device credentials.
# Enable only after installing the account-capable frontend and backend together.
ACCOUNTS_ENABLED=false
ACCOUNTS_ADMIN_USERNAME=admin
ACCOUNTS_REGISTRATION_ENABLED=false
ACCOUNTS_SESSION_HOURS=12
# Set true when the application is served over HTTPS.
ACCOUNTS_SECURE_COOKIE=false
# On first account-mode startup, the existing LAB_MANAGER_PASSWORD initializes
# this admin's password. It is hashed in the database; there is no default password.
# Existing accounts are never reset from this environment variable.
